---
import Layout from "@layouts/layout.astro";
import { getCollection } from "astro:content";
import Articlecard from "@layouts/articlecard.astro";
import { formatDate } from "@util";
import writersMetadataImport from "../data/writers.json" assert { type: "json" };

const writersMetadata: Record<string, Writer> = writersMetadataImport;

interface Writer {
  name: string;
  description: string;
  profile: string | null;
  user_id: string;
  team: boolean;
}

let featuredFound = false;
const posts = await getCollection("posts");
---

<Layout>
  <header class="bg-[url(/assets/vermont.png)] pt-20 pb-15 px-30">
    <p class="text-xl font-fairplay italic">Hello there Hack Clubber! Welcome to...</p>
    <h1 class="text-4xl mb-5">The Hacker Press</h1>
    <p class="">Hack Club's official newspaper/blog. Find articles here about the Slack, Hack Club's events, and more :D.</p>
  </header>
  <div class="flex flex-row gap-5 bg-accent-header text-white px-4 md:px-30 py-8">
    <h2 class="sr-only">Featured Article</h2>
    {
      posts.map((post) => {
        if (post.data.tags?.includes("featured")) {
          console.log("Found featured post:", post.data.title);
          if (featuredFound) {
            console.error("Holup, you can't have more than one featured post!");
            return null;
          }
          featuredFound = true;
          return (<a href={`/posts/${post.data.slug}`}><div class="flex flex-col md:flex-row gap-5">
            <img
              src={post.data.image}
              alt=""
              class="rounded-md w-95 h-85 object-cover"
            />
            <div class="text-white">
              <div class="flex flex-row flex-wrap gap-2 mb-3">
                {post.data.tags.map((tag) => {
                  return (
                    <span class="bg-[#FFBA85] font-lexend text-crust px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  );
                })}
              </div>
              <h3 class="text-4xl font-lora">{post.data.title}</h3>
              <p class="text-lg font-atkinson my-4">{post.data.description}</p>
              <p class="text-[#A8A8A8] mb-2">{formatDate(post.data.date)}</p>
              <div class="flex flex-row items-center gap-1">
                <div class="inline-flex ml-3">
                {
                post.data.authors.map((author, index) => {
                  return (
                    <span class="relative -ml-3">
                      <img
                        src={writersMetadata[author].profile}
                        alt=""
                        class="w-8 h-8 rounded-full border-1 border-[#F6ECEC]"
                        aria-hidden="true"
                      />
                    </span>
                  );
                })
                }
                </div>
                <p class="font-lexend font-medium text-[#A8A8A8]">
                {
                post.data.authors.map((author, index) => {
                  const name = writersMetadata[author].name as string;
                  const isLast = index === post.data.authors.length - 1;
                  return (
                    <span>{name}{!isLast && ", "}</span>
                  );
                })
                }
                </p>
              </div>
            </div>
          </div></a>);
        }
      })
    }
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 my-4 mx-4 md:mx-30">
    <h2 class="sr-only">All Articles</h2>
    {
      posts.map((post) => {
        if (post.data.tags?.includes("featured")) {
          return; // do not list featured post here as it's alr featured above
        }
        return <Articlecard data={post.data} />;
      })
    }
  </div>
</Layout>
